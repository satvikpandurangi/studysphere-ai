{
  "name": "studysphere-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "build": "tsc -b && vite build --configLoader runner",
    "lint": "eslint .",
    "test": "vitest run --configLoader runner",
    "test:hosted": "node scripts/hosted-check.mjs",
    "preview": "vite preview --configLoader runner --host 127.0.0.1",
    "app:dev": "wrangler dev --config wrangler.app.toml",
    "app:check": "wrangler deploy --config wrangler.app.toml --dry-run",
    "app:deploy": "wrangler deploy --config wrangler.app.toml",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "check:worker": "tsc --noEmit -p tsconfig.worker.json",
    "worker:bundle": "vite build --config vite.worker-bundle.config.ts --configLoader runner",
    "worker:deploy:bundle": "wrangler deploy --config wrangler.deploy.toml",
    "docs:check": "node scripts/check-docs.mjs",
    "pilot:check": "node scripts/pilot-check.mjs",
    "storage:inventory": "node scripts/storage-inventory.mjs",
    "content:fixtures": "node scripts/build_test_library.mjs",
    "content:sources": "python scripts/download_test_library.py",
    "content:prepare-oer": "python scripts/prepare_oer_sections.py",
    "content:coverage": "node scripts/curriculum_coverage.mjs",
    "package:source": "python scripts/package_source.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.58.0",
    "@xyflow/react": "12.8.6",
    "dompurify": "3.2.6",
    "lucide-react": "0.468.0",
    "pdfjs-dist": "5.4.54",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.8.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260921.1",
    "@electric-sql/pglite": "0.5.11",
    "@eslint/js": "9.34.0",
    "@types/dompurify": "3.2.0",
    "@types/node": "22.18.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.3.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vite": "7.1.4",
    "vitest": "3.2.4",
    "wrangler": "4.136.1"
  }
}
